# GP5 (XDC modern geth) node configuration
# Copy this file to config.env and edit it:  cp config.env.example config.env

# --- Identity -------------------------------------------------------------
# Name shown to peers and on stats dashboards. Use your own name, e.g. alice-test
NODE_NAME=my-gp5-node

# --- Network --------------------------------------------------------------
# apothem (testnet, chain ID 51) or mainnet (chain ID 50)
NETWORK=apothem

# --- Client binary --------------------------------------------------------
GETH_VERSION=v1.17.10-xdc.26
GETH_URL=https://xdc.network/snapshots/bin/geth-${GETH_VERSION}-linux-amd64
# Optional: expected sha256 of the binary. Leave empty to skip the check
# (setup prints the hash it downloaded so you can pin it here).
GETH_SHA256=

# --- Sync -----------------------------------------------------------------
# full | snap
SYNC_MODE=full
# path (recommended, recovers from crashes) | hash
STATE_SCHEME=path

# --- Ports ----------------------------------------------------------------
P2P_PORT=30303
RPC_PORT=8545
# 127.0.0.1 = RPC only reachable from this server (recommended).
# Use an SSH tunnel to reach it from your laptop.
RPC_ADDR=127.0.0.1
RPC_APIS=eth,net,web3,admin,debug,txpool,XDPoS

# --- Stats dashboard (optional) -----------------------------------------
# Format: <secret>@<host>:<port>   (node name is added automatically)
# Leave empty to disable.
ETHSTATS=

# --- Advanced -------------------------------------------------------------
# Seconds geth gets to save state on stop/restart before being killed
STOP_TIMEOUT=300
# Runtime image: provides glibc >= 2.38 needed by the GP5 binary
RUNTIME_IMAGE=ubuntu:24.04
# Extra geth flags, e.g. "--verbosity 4 --maxpeers 50"
EXTRA_FLAGS=
